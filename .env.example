# NEAR Network (testnet or mainnet)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Agent Identity on NEAR
NEAR_ACCOUNT_ID=agentguard.testnet
# Function Call Key (optional or mock key for local testing)
NEAR_PRIVATE_KEY=ed25519:mock_key_for_testing

# NEAR AI Cloud Configuration (https://cloud.near.ai)
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_API_KEY=mock-key-or-your-near-ai-api-key
NEAR_AI_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Agent Security Policy (hard spending limits)
MAX_SPEND_PER_TX_USD=2.00
DAILY_BUDGET_USD=5.00
MAX_ALLOWANCE_NEAR=2.00

# Simulation Mode (True = allows tests & judges to run without live credits)
SIMULATION_MODE=true
