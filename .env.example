# Rete NEAR (testnet o mainnet)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Identità dell'Agente su NEAR
NEAR_ACCOUNT_ID=agentguard.testnet
# Chiave Function Call (opzionale o fittizia per i test locali)
NEAR_PRIVATE_KEY=ed25519:mock_key_for_testing
# Configurazione NEAR AI Cloud (https://cloud.near.ai)
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_API_KEY=mock-key-or-your-near-ai-api-key
NEAR_AI_MODEL=meta-llama/Llama-3.1-70B-Instruct
# Policy di Sicurezza dell'Agente (limiti invalicabili)
MAX_SPEND_PER_TX_USD=2.00
DAILY_BUDGET_USD=5.00
MAX_ALLOWANCE_NEAR=2.00
# Modalità Simulazione (True = consente ai test e giudici di girare senza crediti reali)
SIMULATION_MODE=true
